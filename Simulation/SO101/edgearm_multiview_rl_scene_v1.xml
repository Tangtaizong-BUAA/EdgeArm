    <camera name="edgearm_front" pos="0.62 0 0.24"
      xyaxes="0 1 0 -0.35 0 0.94" fovy="50" />
  </worldbody>

  <keyframe>
    <key name="home"
      qpos="0 -0.55 0.95 -0.45 0 0.35 0.22 -0.08 0.051 1 0 0 0"
      ctrl="0 -0.55 0.95 -0.45 0 0.35"
