    <body name="arm_push_plate" mocap="true" pos="0.14 -0.08 0.062">
      <geom name="arm_push_plate_geom" type="box" size="0.052 0.008 0.025"
        material="edgearm_push_plate" friction="1.0 0.01 0.001" />
